# Only loaded by `npm run dev` (Vite's development mode), never by
# `npm run build`. The dev server runs on its own port (5173) separate from
# the signaling server (8000), so same-origin resolution doesn't apply here
# — point it at the signaling server explicitly. Production builds leave
# this unset on purpose; see .env.example at the repo root.
VITE_SIGNALING_SERVER_URL=ws://localhost:8000/ws

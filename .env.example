# Signaling server
SIGNALING_SERVER_HOST=0.0.0.0
SIGNALING_SERVER_PORT=8000

# Host app — always localhost: the host app and signaling server run on the
# same machine, so this never depends on Tailscale or any network being up.
SIGNALING_SERVER_URL=ws://localhost:8000/ws

# Viewer app: deliberately NOT set here. The production build (what start.bat
# ships) leaves this unset so the viewer connects back to whichever address
# the browser used to load the page — the launcher's tray icon shows both a
# LAN and a Tailscale URL, and either one just works. `npm run dev`'s own
# local override lives in viewer-app/.env.development instead (Vite reads it
# automatically in dev mode only).

# TURN server credentials (host app). Optional — a public Google STUN server is
# always used as a baseline, TURN is only needed when NAT blocks a direct path.
# Left commented out so `cp .env.example .env` yields a working STUN-only setup
# instead of a dead placeholder relay — uncomment once coturn is deployed.
#TURN_SERVER_URL=turn:your-turn-server:3478
#TURN_USERNAME=screentracker
#TURN_PASSWORD=changeme

# Same TURN credentials for the viewer app (Vite requires the VITE_ prefix)
#VITE_TURN_SERVER_URL=turn:your-turn-server:3478
#VITE_TURN_USERNAME=screentracker
#VITE_TURN_PASSWORD=changeme
